// conf/test_its.config

params {
    input    = "${projectDir}/tests/assets/its/sampledata_test.tsv"
    metadata = "${projectDir}/tests/assets/its/metadata_test.tsv"

    nb_databases      = ['euk_its']
    vsearch_databases = ['euk_its']

    // ITS
    forward_p = 'TCCGTAGGTGAACCTGC'
    reverse_p = 'GCATATCAATAAGCGGAGGA'

    // VSEARCH LCA
    vsearch_lca_id         = 0.90
    vsearch_lca_query_cov  = 0.85
    vsearch_lca_maxaccepts = 0
    vsearch_lca_maxrejects = 0
    vsearch_lca_cutoff     = 0.90

    dada2_nb_min_boot = 0
    dada2_nb_try_rc = false
    dada2_nb_output_bootstraps = true

    min_len = 500
    max_len = 1000

}

